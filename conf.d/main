#!/bin/bash -ex
# The nodebb layer (handbook note 0082, section 7, step 1): NodeBB 4.16.7 on
# the lnpp layer, with the Node.js of the Keel package keel-nodejs (note
# 0083). It runs in the image chroot, after the overlay is in place.
#
# 0. Node.js is the package of one line, keel-nodejs-24 (note 0083; one
#    package for each line, the maintainer on 2026-11-12).
# 1. The code is the release tarball of NodeBB at a pinned sha256, owned by
#    root in /var/www/nodebb. The dependencies come from the reviewed lock
#    file of this layer (usr/share/keel-nodebb/package-lock.json) with
#    `npm ci`: NodeBB ships no lock file. npm 11 runs no install script of
#    a dependency unless it is approved, and none is.
# 2. NodeBB writes build/, logs/ and the pidfile of each node, and its
#    uploads in /var/lib/nodebb/uploads, which a pair replicates. The user
#    nodebb owns these and nothing else of the tree.
# 3. The assets are built here, so the first boot is short. A build needs a
#    database, so this script runs a scratch setup against the PostgreSQL
#    of the image and removes the database, the role and config.json
#    after it. The first boot hook (45nodebb) makes them again from the spec.
# 4. The check page of lnpp is removed, as keel-odoo removes it.

# The shebang sets -e and -x, and a call as `bash conf.d/main` ignores it.
set -ex

NODEBB_VERSION=4.16.7
NODEBB_SHA256=6aedead659866e442e11be7a72cc07a63ae644a72d99ff61ed3b25e5178daf8d
NODEBB_URL="https://github.com/NodeBB/NodeBB/archive/refs/tags/v${NODEBB_VERSION}.tar.gz"
NODEBB_DIR=/var/www/nodebb
NODE_LINE=24
LOCK=/usr/share/keel-nodebb/package-lock.json

export npm_config_cafile=/etc/ssl/certs/ca-certificates.crt
if [ -n "${FAB_HTTP_PROXY:-}" ]; then
    export http_proxy="$FAB_HTTP_PROXY" https_proxy="$FAB_HTTP_PROXY"
fi

# Node.js is the Keel package, never a download of this layer (note 0083)
dpkg-query -W -f '${Status}\n' "keel-nodejs-$NODE_LINE" | grep -qx 'install ok installed'
[ "$(node --version | cut -d. -f1)" = "v$NODE_LINE" ]

adduser --system --group --home /var/lib/nodebb --no-create-home \
    --shell /usr/sbin/nologin nodebb
install -d -o nodebb -g nodebb -m 0750 /var/lib/nodebb
install -d -o nodebb -g nodebb -m 0755 /var/lib/nodebb/uploads
install -d -m 0755 /var/lib/keel-nodebb

# the release tarball, checked against the pinned digest
tmp="$(mktemp -d)"
curl --fail --silent --show-error --location --retry 3 --output "$tmp/nodebb.tar.gz" "$NODEBB_URL"
echo "$NODEBB_SHA256  $tmp/nodebb.tar.gz" | sha256sum --check --strict
rm -rf "$NODEBB_DIR"
mkdir -p "$NODEBB_DIR"
tar -C "$NODEBB_DIR" --strip-components=1 --no-same-owner -xzf "$tmp/nodebb.tar.gz"
rm -rf "$tmp"
grep -q "\"version\": \"$NODEBB_VERSION\"" "$NODEBB_DIR/install/package.json"
# No container files of upstream in a Keel image
rm -rf "$NODEBB_DIR"/Dockerfile "$NODEBB_DIR"/dev.Dockerfile "$NODEBB_DIR"/docker-compose*.yml \
    "$NODEBB_DIR"/.docker "$NODEBB_DIR"/.dockerignore
# tar as root keeps the modes of the archive, 0664 and 0775 (CT 9385,
# 2026-11-11): nobody but root writes the code
chmod -R u+rwX,go+rX,go-w "$NODEBB_DIR"

cd "$NODEBB_DIR"
cp install/package.json package.json
install -m 0644 "$LOCK" package-lock.json
python3 -c 'import json, sys; lock = json.load(open(sys.argv[1])); sys.exit(0 if lock["packages"][""]["version"] == sys.argv[2] else 1)' \
    package-lock.json "$NODEBB_VERSION"
HOME=/root npm ci --omit=dev --no-audit --no-fund
rm -rf /root/.npm

# what NodeBB writes on each node
install -d -o nodebb -g nodebb -m 0755 build logs
install -o nodebb -g nodebb -m 0644 /dev/null pidfile

# nodebb-plugin-emoji builds its data in build/emoji of its own directory
# at the first start of a node (static:app.load, when build/emoji/table.json
# is missing) and when an admin asks for a new build. It removes the
# directory and makes it again, so it needs write on build/ of the plugin.
# With a root-owned tree that was EROFS, and no emoji worked (CT 9385,
# 2026-11-11). nodebb owns that directory and build/emoji with its files,
# not build/lib and the other files, and nodebb.service allows it. build/lib
# holds the code of the plugin: a link of build/ into /var/www/nodebb/build
# removed that code.
# begin: emoji
chown nodebb:nodebb /var/www/nodebb/node_modules/nodebb-plugin-emoji/build
chown -R nodebb:nodebb /var/www/nodebb/node_modules/nodebb-plugin-emoji/build/emoji
# end: emoji

# The scratch setup that builds the assets. The layers below removed the
# snake oil certificate that postgresql.conf names, so the server starts
# with TLS off, for this step alone.
PGVER="$(ls /etc/postgresql/)"
pg_ctlcluster --skip-systemctl-redirect "$PGVER" main start -o "-c ssl=off"
trap 'pg_ctlcluster --skip-systemctl-redirect "$PGVER" main stop || true' EXIT
# no trace while the scratch passwords are in the environment
set +x
APP_PASS="$(openssl rand -hex 24)"
DB_PASS="$(openssl rand -hex 24)"
export APP_PASS DB_PASS KEEL_SECRET_NODEBB_SECRET=build-time-only
/usr/lib/inithooks/bin/nodebb.py --domain=nodebb.invalid --email=admin@nodebb.invalid --admin=admin
unset APP_PASS DB_PASS KEEL_SECRET_NODEBB_SECRET
set -x
test -d build/public
# The active set of this build: serve.py builds again when the set of the
# database is another
runuser -u postgres -- psql -X -q -At -d nodebb -c "$(python3 -c 'import sys; sys.path.insert(0, "/usr/lib/keel-nodebb"); import serve; print(serve.ACTIVE_SET)')" \
    | runuser -u nodebb -- tee build/keel-active-set
runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d postgres \
    -c "DROP DATABASE nodebb" -c "DROP ROLE nodebb"
rm -f config.json /var/lib/keel-nodebb/ready
rm -rf logs/* /var/lib/nodebb/.npm /var/lib/nodebb/uploads/*
pg_ctlcluster --skip-systemctl-redirect "$PGVER" main stop
trap - EXIT

# NodeBB runs on every node: usr/lib/keel-nodebb/serve.py starts it on the
# node whose PostgreSQL is writable, after the first boot hook.
systemctl enable nodebb.service
# NodeBB keeps the old Node.js binary until it restarts, and keel-nodejs-24
# has no maintainer script (the maintainer, 2026-11-12). This path unit of
# the layer restarts NodeBB when the binary changes.
systemctl enable nodebb-nodejs.path

# The front site of Keel Web must include keel-front.d, so an upload is not
# stopped at 1 MB behind Anubis (as keel-odoo checks it).
SNIPPET=/etc/nginx/snippets/keel-web-front.conf
grep -qxF 'include /etc/nginx/keel-front.d/*.conf;' "$SNIPPET" \
    || { echo "the front site of keel-web does not include keel-front.d: keel-web 0.4.0 is the least" >&2; exit 1; }

# The stack check of lnpp is not part of the NodeBB product (keel-odoo
# removes it for the same reason): the hook, the route, the application,
# the socket, the service unit and its user.
# A second run finds them gone already.
if [ -e /usr/lib/systemd/system/keel-lnpp-check.socket ]; then
    systemctl disable keel-lnpp-check.socket
fi
rm -rf /usr/lib/inithooks/firstboot.d/40lnpp-check \
    /etc/nginx/keel-default.d/50-keel-lnpp.conf \
    /usr/share/keel-lnpp \
    /usr/lib/systemd/system/keel-lnpp-check.socket \
    /usr/lib/systemd/system/keel-lnpp-check.service
if getent passwd keel-check > /dev/null; then
    userdel keel-check
fi

# The appliance manifest, validated and resolved along lnpp, web and core
keel manifest validate nodebb
