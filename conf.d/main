#!/bin/bash -ex
# Install NodeBB under /var/www/nodebb from the pinned release tarball,
# fetch its dependencies, run a build time setup against a scratch Redis so
# the static assets are compiled in the image, then remove every trace of
# that setup: the first boot hook (firstboot.d/40nodebb) runs the real
# setup from the instance spec.

# 4.10.3 is the last release whose own dependency pins run on Node.js 20
# (Debian 13): 4.11.0 and later pin undici 8.1.0, which needs Node 22.19.
NODEBB_VERSION=4.10.3
NODEBB_SHA256=093b29081970f30d7f3b3863833e606861da29c6cf9438616de3c6c6675906a7
NODEBB_URL="https://github.com/NodeBB/NodeBB/archive/refs/tags/v${NODEBB_VERSION}.tar.gz"
NODEBB_USER=nodebb
NODEBB_DIR=/var/www/nodebb
REDIS_CONF=/etc/redis/redis.conf

# npm reaches the registry through the build proxy when fab sets one, and
# always through the system trust store.
export npm_config_cafile=/etc/ssl/certs/ca-certificates.crt
if [[ -n "$FAB_HTTP_PROXY" ]]; then
    export http_proxy="$FAB_HTTP_PROXY" https_proxy="$FAB_HTTP_PROXY"
fi

# service user
adduser --system --group --home "$NODEBB_DIR" --no-create-home \
    --shell /usr/sbin/nologin "$NODEBB_USER"

# release tarball, verified against the pinned digest
tmp=$(mktemp -d)
curl -fsSL -o "$tmp/nodebb.tar.gz" "$NODEBB_URL"
echo "$NODEBB_SHA256  $tmp/nodebb.tar.gz" | sha256sum --check --strict
mkdir -p "$NODEBB_DIR"
tar -C "$NODEBB_DIR" --strip-components=1 -xzf "$tmp/nodebb.tar.gz"
rm -rf "$tmp"
grep -q "\"version\": \"$NODEBB_VERSION\"" "$NODEBB_DIR/install/package.json"
chown -R "$NODEBB_USER:$NODEBB_USER" "$NODEBB_DIR"

as_nodebb() {
    runuser -u "$NODEBB_USER" -- env HOME="$NODEBB_DIR" NODE_ENV=production \
        npm_config_cafile="$npm_config_cafile" \
        http_proxy="${http_proxy:-}" https_proxy="${https_proxy:-}" "$@"
}

# dependencies: what "./nodebb install" does, as explicit steps
cd "$NODEBB_DIR"
as_nodebb cp install/package.json package.json
as_nodebb npm install --omit=dev --no-audit --no-fund

# Redis: loopback only, both families (Debian's default, made explicit)
sed -i 's|^bind .*|bind ::1 127.0.0.1|' "$REDIS_CONF"
grep -q '^bind ::1 127.0.0.1$' "$REDIS_CONF"

# build time setup against a scratch Redis so the assets get compiled; the
# values are throwaway and everything they produce is wiped below. The
# scratch instance is a plain process without persistence on its own port:
# the chroot shares the host's network, so a service started here would
# collide with, or survive as, a process on the build host.
SCRATCH_PORT=16379
runuser -u redis -- redis-server --bind 127.0.0.1 --port $SCRATCH_PORT --save "" \
    --appendonly no --dir /tmp --daemonize yes --pidfile /tmp/redis-scratch.pid \
    --logfile /tmp/redis-scratch.log
for _ in $(seq 1 30); do
    [[ "$(redis-cli -p $SCRATCH_PORT ping 2>/dev/null)" == PONG ]] && break
    sleep 1
done
[[ "$(redis-cli -p $SCRATCH_PORT ping)" == PONG ]]
scratch_pass=$(openssl rand -base64 18)
as_nodebb ./nodebb setup "$(python3 -c 'import json,sys; print(json.dumps({
  "url": "http://localhost:4567", "secret": "build-time-only", "database": "redis",
  "redis:host": "127.0.0.1", "redis:port": int(sys.argv[2]), "redis:password": "", "redis:database": 0,
  "admin:username": "admin", "admin:password": sys.argv[1], "admin:password:confirm": sys.argv[1],
  "admin:email": "admin@example.com"}))' "$scratch_pass" "$SCRATCH_PORT")"
test -d "$NODEBB_DIR/build/public"
redis-cli -p $SCRATCH_PORT flushall
redis-cli -p $SCRATCH_PORT shutdown nosave
rm -f /tmp/redis-scratch.pid /tmp/redis-scratch.log /var/lib/redis/dump.rdb
rm -f "$NODEBB_DIR/config.json" "$NODEBB_DIR/pidfile"
rm -rf "$NODEBB_DIR/logs"/* "$NODEBB_DIR/.npm" /root/.npm
chown -R "$NODEBB_USER:$NODEBB_USER" "$NODEBB_DIR"

# nginx: the NodeBB site replaces the default one
rm -f /etc/nginx/sites-enabled/*
ln -s /etc/nginx/sites-available/nodebb /etc/nginx/sites-enabled/nodebb

# systemd: the unit is conditioned on config.json, so it stays inert until
# the first boot hook has run the setup
systemctl enable nodebb

# fab-plan-resolve keeps a package the parent layer already carries at the
# parent's version, so the two core packages are upgraded here from the
# build time source (keel, new in the plan, was installed from it already).
#
# The overlay of this appliance ships /etc/confconsole/services.txt, which
# is a conffile of confconsole, so dpkg sees it as locally modified and asks
# what to do with it. The conf script runs with stdin closed, dpkg reads end
# of file at the prompt and leaves confconsole "install ok unpacked", which
# fails this script. Keep the overlay's file without asking.
export DEBIAN_FRONTEND=noninteractive
apt-get install -y --only-upgrade \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    inithooks confconsole
dpkg-query -W -f '${Package} ${Version} ${Status}\n' inithooks confconsole keel

# conf.d/zz-project-packages runs after this script: it checks these three
# against the archive the build read and then removes the build time source.
# No version is asserted here, because a literal one passes on a stale index.
