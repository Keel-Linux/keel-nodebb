# NodeBB behind nginx. IPv6 first: the listeners take [::] and 0.0.0.0, the
# upstream is NodeBB on the IPv6 loopback.
#
# The forum is served at the apex (keellinux.org) by a public services VM
# that terminates TLS and reverse proxies to this appliance over IPv6 on
# port 80. $nodebb_scheme (conf.d/nodebb-proxy.conf) is "https" when such a
# request comes from a trusted proxy with X-Forwarded-Proto: https, and the
# request's own scheme otherwise; anything else on port 80 is redirected.

upstream nodebb {
    server [::1]:4567;
}

server {
    listen [::]:80 default_server;
    listen 80 default_server;
    server_name _;

    # ACME http-01 answers stay on port 80
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        if ($nodebb_scheme != https) {
            return 307 https://$host$request_uri;
        }
        include /etc/nginx/include/nodebb-proxy;
    }
}

server {
    listen [::]:443 ssl default_server;
    listen 443 ssl default_server;
    server_name _;
    include /etc/nginx/snippets/ssl.conf;

    location / {
        include /etc/nginx/include/nodebb-proxy;
    }
}
